{
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
